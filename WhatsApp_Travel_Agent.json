    {
      "parameters": {
        "jsCode": "// Four variations of the pre-trip message, so WhatsApp doesn't see identical repeated text\nconst messages = [\n  \"Hey {name}! Your trip is just 3 days away 🌴 Here's your checklist: passport, chargers, and that vacation mindset.\\n\\nWarm regards,\\nTravel Beta\",\n  \"Hi {name}, quick heads up — you're 3 days out from departure! Double check your documents and start packing.\\n\\nWarm regards,\\nTravel Beta\",\n  \"{name}, your adventure is almost here! In 3 days you're off. Make sure your travel documents and essentials are sorted.\\n\\nWarm regards,\\nTravel Beta\",\n  \"Hello {name}! Just 3 more days till you fly out. A gentle nudge to finish packing and confirm your documents.\\n\\nWarm regards,\\nTravel Beta\"\n];\n\n// Get the current row's data\nconst row = $input.item.json;\n\n// Pick one message at random\nconst randomIndex = Math.floor(Math.random() * messages.length);\nconst chosenMessage = messages[randomIndex];\n\n// Swap in the client's actual name\nconst finalMessage = chosenMessage.replace('{name}', row.Name);\n\n// Build a clean WhatsApp chatId: keep digits only, then append @c.us\nconst chatId = String(row['WhatsApp Number']).replace(/\\D/g, '') + '@c.us';\n\n// Return the row with the new fields added\nreturn {\n  json: {\n    ...row,\n    message: finalMessage,\n    chatId: chatId\n  }\n};"
      },
