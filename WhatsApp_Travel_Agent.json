      "parameters": {
        "jsCode": "// Four variations of the welcome-back message\nconst messages = [\n  \"Welcome back, {name}! How was the trip? We'd love to hear all about it whenever you have a moment.\\n\\nWarm regards,\\nTravel Beta\",\n  \"Hey {name}, hope you landed safely! How was your trip? Let us know if there's anything we can help with.\\n\\nWarm regards,\\nTravel Beta\",\n  \"{name}, welcome home! We hope the trip was unforgettable. Would love to hear how it went!\\n\\nWarm regards,\\nTravel Beta\",\n  \"Hi {name}! Glad you're back. How was everything? Always here if you need help planning the next one.\\n\\nWarm regards,\\nTravel Beta\"\n];\n\n// Get the current row's data\nconst row = $input.item.json;\n\n// Pick one message at random\nconst randomIndex = Math.floor(Math.random() * messages.length);\nconst chosenMessage = messages[randomIndex];\n\n// Swap in the client's actual name\nconst finalMessage = chosenMessage.replace('{name}', row.Name);\n\n// Return the row with the new \"message\" field added\nreturn {\n  json: {\n    ...row,\n    message: finalMessage\n  }\n};"
      },
